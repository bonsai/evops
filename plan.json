{
  "project": "ssss",
  "title": "VLMを用いた異種アニメーション生成バックエンドの共通評価・改善ループ",
  "status": "research",
  "duration_days": 10,
  "goal": "Blender/bpy、SVG/CSS、SD1.5を同一の評価軸で比較し、VLMを中心とした評価→失敗分析→修正→再生成ループの有効性を検証する。",
  "hypotheses": [
    {"id":"H1","statement":"VLMベースの意味・知覚評価は異なる生成バックエンドで共通利用できる。"},
    {"id":"H2","statement":"評価軸を構造化してDB化すると、実験比較と改善知識の再利用性が高まる。"},
    {"id":"H3","statement":"VLMの失敗記述を修正指示へ変換すると、次回生成の品質改善に利用できる。"},
    {"id":"H4","statement":"Blender/bpyやSVG/CSSの決定的バックエンドは、SD1.5より短く制御しやすい改善ループを構成できる。"}
  ],
  "common_loop": ["intent","generate","render","evaluate","failure_analysis","repair","regenerate"],
  "backends": [
    {"id":"blender","technology":"Blender/bpy","role":"main","reason":"決定的・編集可能・3Dアニメーションに適する"},
    {"id":"svg_css","technology":"SVG/CSS","role":"baseline","reason":"高速な2Dアニメーション評価環境"},
    {"id":"sd15","technology":"Stable Diffusion 1.5","role":"baseline","reason":"生成AI系との比較。速度と時間的一貫性を測定"}
  ],
  "evaluation_axes": [
    {"id":"semantic","name":"Semantic Alignment","method":"VLM","direction":"higher_better"},
    {"id":"motion","name":"Motion Quality","method":"VLM+Python","direction":"higher_better"},
    {"id":"temporal","name":"Temporal Consistency","method":"VLM+Python","direction":"higher_better"},
    {"id":"character","name":"Character Consistency","method":"VLM","direction":"higher_better"},
    {"id":"composition","name":"Composition","method":"VLM","direction":"higher_better"},
    {"id":"visual_quality","name":"Visual Quality","method":"VLM","direction":"higher_better"},
    {"id":"artifact","name":"Artifact","method":"VLM+Python","direction":"lower_better"}
  ],
  "architecture": {
    "python":"評価、画像/動画解析、DB、研究用ライブラリ、プロトタイピング",
    "mcp":"Blender等の外部ツール操作インターフェース",
    "skill":"評価知識・制作知識・修正知識の再利用可能な手順",
    "rust":"実測された画像/動画処理ボトルネックがある場合のみ導入",
    "vlm":"意味・知覚・失敗理由・修正指示の評価者"
  },
  "days": [
    {"day":1,"theme":"文献・評価軸","deliverable":"papers.md と evaluation axes の初版"},
    {"day":2,"theme":"評価DB","deliverable":"JSONL schema と実験記録の初版"},
    {"day":3,"theme":"VLM evaluator","deliverable":"JSON出力を強制する評価prompt"},
    {"day":4,"theme":"SVG/CSS baseline","deliverable":"高速2D生成・レンダリング・評価"},
    {"day":5,"theme":"Blender/bpy baseline","deliverable":"基本キャラクターと歩行等の生成・評価"},
    {"day":6,"theme":"Blender MCP","deliverable":"MCP経由の生成・再生成ループ"},
    {"day":7,"theme":"SD1.5 baseline","deliverable":"生成時間・品質・一貫性の比較データ"},
    {"day":8,"theme":"repair loop","deliverable":"VLM failure → repair instruction → regenerate"},
    {"day":9,"theme":"cross-backend experiment","deliverable":"同一Intentによる3バックエンド比較"},
    {"day":10,"theme":"分析・公開","deliverable":"HTML dashboard と研究結果まとめ"}
  ],
  "primary_experiment": {
    "intent_id":"character_walk_001",
    "subject":"simple cartoon robot",
    "action":"walk left to right",
    "scene":"simple studio",
    "camera":"medium shot, static",
    "duration_seconds":3,
    "style":"cartoon"
  },
  "deliverables": ["plan.json","plan.md","plan.html","papers.md","evaluation-axes.jsonl","experiments.jsonl","evaluations.jsonl","iterations.jsonl"],
  "success_criteria": [
    "同一Intentを3バックエンドで実行できる",
    "共通評価JSONを取得できる",
    "失敗理由から修正指示を生成できる",
    "少なくとも1回の再生成で改善差を測定できる",
    "結果をHTMLで比較表示できる"
  ]
}