{
  "project": "ssss",
  "title": "VLMを用いた異種アニメーション生成バックエンドの共通評価・改善ループ",
  "status": "research",
  "duration_days": 10,
  "goal": "Blender/bpy（テーマ2: ドラえもん）、SVG/CSS（テーマ1）、SD1.5を同一の評価軸で比較し、VLMを中心とした評価→失敗分析→修正→再生成ループ、およびbqmliteによる自動修復戦略学習の有効性を検証する。",
  "hypotheses": [
    {
      "id": "H1",
      "statement": "VLMベースの意味・知覚評価は異なる生成バックエンドで共通利用できる。"
    },
    {
      "id": "H2",
      "statement": "評価軸を構造化してDB化すると、実験比較と改善知識の再利用性が高まる。"
    },
    {
      "id": "H3",
      "statement": "VLMの失敗記述を修正指示へ変換すると、次回生成の品質改善に利用できる。"
    },
    {
      "id": "H4",
      "statement": "Blender/bpyやSVG/CSSの決定的バックエンドは、SD1.5より短く制御しやすい改善ループを構成できる。"
    }
  ],
  "common_loop": [
    "intent",
    "generate",
    "render",
    "evaluate",
    "failure_analysis",
    "repair",
    "regenerate"
  ],
  "backends": [
    {
      "id": "blender",
      "technology": "Blender/bpy",
      "role": "main",
      "reason": "決定的・編集可能・3Dアニメーションに適する"
    },
    {
      "id": "svg_css",
      "technology": "SVG/CSS",
      "role": "baseline",
      "reason": "高速な2Dアニメーション評価環境"
    },
    {
      "id": "sd15",
      "technology": "Stable Diffusion 1.5",
      "role": "baseline",
      "reason": "生成AI系との比較。速度と時間的一貫性を測定"
    }
  ],
